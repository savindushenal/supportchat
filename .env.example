# Copy to `.env.local` — never commit secrets.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the service_role key on the server only (bypasses RLS for chat updates)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — natural conversation (free tier at AI Studio)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model — if unset, app tries gemini-2.0-flash then other flash models
GEMINI_MODEL=gemini-2.0-flash

# Notify.lk SMS (OTP for full tracking details)
# https://app.notify.lk — phone format 94XXXXXXXXX
NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=TransExpress

# Public app URL (used in invoice PDF links in chat)
NEXT_PUBLIC_APP_URL=http://localhost:3000
